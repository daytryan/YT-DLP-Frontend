{
  "manifest_version": 3,
  "name": "yt-dlp downloader",
  "version": "2.1",
  "key": "",
  "description": "Download the current YouTube video or its audio with yt-dlp.",
  "permissions": [
    "activeTab",
    "storage",
    "nativeMessaging",
    "cookies"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "panel.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.google.com/*"
  ]
}